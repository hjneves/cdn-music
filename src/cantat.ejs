---
siteTitle: 'Cantat'
title: 'Cantat - Concertos e Ensaios'
choir: 'cantat'
permalink: 'cantat/index.html'
---

<h2 class="text-2xl font-bold">Concerts</h2>
<% if (collections.posts_cantat_concerts && collections.posts_cantat_concerts.length > 0) { %>
<ul>
  <% [...collections.posts_cantat_concerts].reverse().forEach((post) => { %>
    <% const thumbnail = post.data && post.data.image ? post.data.image : '/assets/images/posts/error.png'; %>
    <li class="mb-3">
      <a href="<%= post.url %>" class="flex items-start gap-3">
        <img src="<%= thumbnail %>" alt="<%= post.data.title %>" class="h-16 w-16 flex-shrink-0 rounded object-cover" />
        <div class="min-w-0">
          <div class="font-semibold text-base text-gray-900 truncate"><%= post.data.title %></div>
          <div class="text-sm text-gray-600 truncate"><%= post.data.place || 'Local não definido' %></div>
          <div class="text-xs text-gray-500 mt-0.5"><%= post.data.date ? this.dateFns.format(new Date(post.data.date), "d 'de' MMMM 'de' yyyy", { locale: ptLocale }) : '' %></div>
        </div>
      </a>
    </li>
  <% }) %>
</ul>
<% } else { %>
<p class="text-gray-500">No concerts yet</p>
<% } %>

<h2 class="text-2xl font-bold mt-6">Rehearsals</h2>
<% if (collections.posts_cantat_rehearsals && collections.posts_cantat_rehearsals.length > 0) { %>
<ul>
  <% [...collections.posts_cantat_rehearsals].reverse().forEach((post) => { %>
